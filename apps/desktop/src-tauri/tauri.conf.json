{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuotai",
  "version": "0.75.1",
  "identifier": "dev.cuotai.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cuotai",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 520,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "tray",
        "url": "tray.html",
        "width": 380,
        "height": 600,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "title": "Cuotai"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDNjI0RThBNUFGQzQ3OTEKUldTUlIveGFpazVpUEZDN2FnNDR3ZUR0VzJjbTM5cXlsR0txZzVmSmdVZDc1N3dQYmVjQkRFd1kK",
      "endpoints": [
        "https://github.com/jmarcon/cuotai/releases/latest/download/latest.json"
      ]
    }
  }
}

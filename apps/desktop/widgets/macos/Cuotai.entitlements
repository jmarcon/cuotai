<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PRD 0014 RF2.1: the (unsandboxed) app's only entitlement: the app group
     it shares with CuotaiWidgets.appex. Applied only with a Developer ID
     signature; an ad-hoc signature carries no Team ID to match the prefix. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>WL9XSC6H36.dev.cuotai.desktop</string>
	</array>
</dict>
</plist>

    "One account you pin, with its binding quota and the age of the measurement.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta fixada por você, com a cota limitante e a idade da medição."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta que fijas, con su cuota limitante y la antigüedad de la medición."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un account che fissi, con la quota vincolante e l'età della misurazione."
          }
        }

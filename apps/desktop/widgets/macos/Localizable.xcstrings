    "Turn on the measurement history in Cuotai Settings to fill this chart.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o histórico de medições nos Ajustes do Cuotai para preencher este gráfico."

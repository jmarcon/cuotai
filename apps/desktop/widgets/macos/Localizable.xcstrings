    "It was removed or is not published. No other account is shown here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela foi removida ou não está publicada. Nenhuma outra conta é mostrada aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó o no está publicada. Aquí no se muestra ninguna otra cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato rimosso o non è pubblicato. Qui non viene mostrato nessun altro account."
          }
        }
      }
    },
    "Runs out before the reset": {
      "localizations": {

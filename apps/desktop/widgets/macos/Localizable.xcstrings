    "It was removed or is not published. No other account is shown here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela foi removida ou não está publicada. Nenhuma outra conta é mostrada aqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó o no está publicada. Aquí no se muestra ninguna otra cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato rimosso o non è pubblicato. Qui non viene mostrato nessun altro account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es wurde entfernt oder nicht veröffentlicht. Hier erscheint kein anderes Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il a été supprimé ou n’est pas publié. Aucun autre compte n’apparaît ici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Она удалена или не опубликована. Другие учётные записи здесь не показываются."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "削除されたか、公開されていません。ここに他のアカウントは表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它已被移除或未发布。此处不会显示其他账户。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "삭제되었거나 게시되지 않았습니다. 여기에는 다른 계정이 표시되지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इसे हटाया गया है या प्रकाशित नहीं किया गया। यहाँ कोई दूसरा खाता नहीं दिखता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Akun dihapus atau tidak diterbitkan. Akun lain tidak ditampilkan di sini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kaldırıldı veya yayımlanmıyor. Burada başka bir hesap gösterilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tài khoản đã bị xóa hoặc không được xuất bản. Ở đây không hiện tài khoản khác."
          }
        }
      }
    },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmarcon/cuotai/blob/main/docs/export-v1.schema.json",
  "title": "Cuotai export v1",
  "description": "cuotai-core export::v1 (PRD 0012 RF1). Additive within schema 1: consumers must ignore unknown properties and tolerate new enum values. See docs/export-v1.md.",
  "type": "object",
  "required": ["schema", "generated_at", "config_identity", "accounts", "local_cost"],
  "properties": {
    "schema": { "const": 1, "description": "Contract version; a removed or redefined field needs 2." },
    "generated_at": { "type": "string", "format": "date-time" },
    "config_identity": { "type": "string", "description": "Lowercase hex SHA-256 of the configuration identity; never the file path." },
    "accounts": { "type": "array", "items": { "$ref": "#/$defs/AccountExport" }, "description": "In configuration order." },
    "local_cost": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/LocalCost" }], "description": "Estimated cost from this computer's local CLI logs (PRD 0015 RF4.3), separate from the providers' reports; null while every local cost source is off or when the producer does not read the cost index." }
  },
  "$defs": {
    "AccountExport": {
      "type": "object",
      "required": [
        "index", "id", "key", "name", "provider", "class", "report", "age_seconds", "freshness",
        "clock_adjusted", "stale", "showing_last_good", "last_good", "binding", "pace", "access", "incident"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "description": "Position in the configuration." },
        "id": { "type": "string", "description": "Stable account id (PRD 0029): survives renames, reordering and parameter edits. Prefer it to key." },
        "key": { "type": "string", "description": "Legacy identity <provider slug>:<name>: stable across reordering, changed by a rename; prefer id." },
        "name": { "type": "string" },
        "provider": { "$ref": "#/$defs/Provider" },
        "email": { "type": ["string", "null"], "description": "Present only when the producer includes identity; null when unknown." },
        "class": { "anyOf": [{ "enum": ["available", "exhausted", "unmeasured"] }, { "type": "string" }] },
        "report": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Report" }], "description": "Current report; null until the account has one." },
        "age_seconds": { "type": ["integer", "null"], "minimum": 0, "description": "Age of report.checked_at; null without a report." },
        "freshness": { "anyOf": [{ "type": "null" }, { "enum": ["fresh", "aging", "stale"] }, { "type": "string" }], "description": "report.checked_at against the account's effective interval; null without a report." },
        "clock_adjusted": { "type": "boolean", "description": "report.checked_at is in the future; the age reads zero." },
        "stale": { "type": "boolean", "description": "true exactly when last_good is present." },
        "showing_last_good": { "type": "boolean", "description": "Alias of stale with the same value: a preserved reading is shown instead of a current one." },
        "last_good": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/LastGood" }] },
        "binding": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Binding" }] },
        "pace": {
          "type": "array",
          "items": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Pace" }] },
          "description": "One entry per report.metrics item, same order, computed at report.checked_at; every entry is null unless freshness is fresh; empty without a report."
        },
        "access": { "$ref": "#/$defs/UsageAccess" },
        "incident": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ProviderIncident" }], "description": "The provider's public status (PRD 0011); null while status queries are off or without a verified source." }
      }
    },
    "Limits": {
      "type": "object",
      "description": "Body of the local server's /v1/limits (PRD 0012 RF2.2): a per-account summary of the export.",
      "required": ["schema", "generated_at", "accounts"],
      "properties": {
        "schema": { "const": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/AccountLimit" }, "description": "In configuration order." }
      }
    },
    "AccountLimit": {
      "type": "object",
      "description": "The same fields as AccountExport, with the same meaning.",
      "required": ["index", "id", "key", "name", "provider", "class", "binding", "age_seconds", "freshness", "stale"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "key": { "type": "string" },
        "name": { "type": "string" },
        "provider": { "$ref": "#/$defs/Provider" },
        "class": { "anyOf": [{ "enum": ["available", "exhausted", "unmeasured"] }, { "type": "string" }] },
        "binding": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Binding" }] },
        "age_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "freshness": { "anyOf": [{ "type": "null" }, { "enum": ["fresh", "aging", "stale"] }, { "type": "string" }] },
        "stale": { "type": "boolean" }
      }
    },
    "Provider": { "type": "string", "description": "Provider slug (docs/providers.md); new providers add values." },
    "Report": {
      "type": "object",
      "required": ["account", "provider", "checked_at", "status", "metrics", "notes", "source"],
      "properties": {
        "account": { "type": "string" },
        "account_id": { "type": "string", "description": "Stable account id (PRD 0029); absent in readings produced without one." },
        "provider": { "$ref": "#/$defs/Provider" },
        "checked_at": { "type": "string", "format": "date-time" },
        "status": { "anyOf": [{ "enum": ["ready", "needs_configuration", "unsupported", "authentication_error", "rate_limited", "error"] }, { "type": "string" }] },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/Metric" } },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "Portuguese texts, redacted." },
        "notes_l10n": { "type": "array", "items": { "$ref": "#/$defs/Localized" }, "description": "Same length and order as notes; absent when empty." },
        "source": { "type": "string", "description": "Public endpoint or reference contract, redacted; may be empty." }
      }
    },
    "Metric": {
      "type": "object",
      "required": ["label", "used", "limit", "remaining", "unit", "kind", "window", "period", "resets_at"],
      "properties": {
        "label": { "type": "string" },
        "used": { "type": ["number", "null"] },
        "limit": { "type": ["number", "null"] },
        "remaining": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "kind": { "anyOf": [{ "enum": ["quota", "rate_limit", "balance", "credits", "spend", "usage"] }, { "type": "string" }] },
        "window": { "anyOf": [{ "type": "null" }, { "enum": ["window_5h", "daily", "weekly", "monthly", "other"] }, { "type": "string" }] },
        "period": { "type": ["string", "null"] },
        "resets_at": { "type": ["string", "null"], "format": "date-time" },
        "billing": { "enum": ["overage"], "description": "Present only on paid extra usage (billed on top of the plan); absent means included in the plan." },
        "scope": {
          "type": "object",
          "required": ["kind", "id", "label"],
          "description": "Present only when the metric limits one model rather than the whole account.",
          "properties": {
            "kind": { "enum": ["model"] },
            "id": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    },
    "LastGoodMetric": {
      "type": "object",
      "required": ["label", "used", "limit", "remaining", "unit", "kind", "window", "period", "resets_at", "expired"],
      "properties": {
        "label": { "type": "string" },
        "used": { "type": ["number", "null"] },
        "limit": { "type": ["number", "null"] },
        "remaining": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "kind": { "anyOf": [{ "enum": ["quota", "rate_limit", "balance", "credits", "spend", "usage"] }, { "type": "string" }] },
        "window": { "anyOf": [{ "type": "null" }, { "enum": ["window_5h", "daily", "weekly", "monthly", "other"] }, { "type": "string" }] },
        "period": { "type": ["string", "null"] },
        "resets_at": { "type": ["string", "null"], "format": "date-time" },
        "expired": { "type": "boolean", "description": "The window renewed after the reading; used, limit and remaining are then null (PRD 0033 RF2)." },
        "renewed_waiting": { "type": "object", "description": "Localized text of an expired metric." }
      }
    },
    "LastGood": {
      "type": "object",
      "required": ["checked_at", "age_seconds", "metrics"],
      "properties": {
        "checked_at": { "type": "string", "format": "date-time", "description": "Original measurement time." },
        "age_seconds": { "type": "integer", "minimum": 0 },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/LastGoodMetric" } }
      }
    },
    "Binding": {
      "type": "object",
      "required": ["index", "label", "window", "used_ratio", "remaining", "resets_at", "reason", "blocked_until"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "description": "Position in report.metrics." },
        "label": { "type": "string" },
        "window": { "anyOf": [{ "type": "null" }, { "enum": ["window_5h", "daily", "weekly", "monthly", "other"] }, { "type": "string" }] },
        "used_ratio": { "type": "number", "minimum": 0 },
        "remaining": { "type": "number" },
        "resets_at": { "type": ["string", "null"], "format": "date-time" },
        "reason": { "anyOf": [{ "enum": ["exhausted", "tightest"] }, { "type": "string" }] },
        "blocked_until": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "Pace": {
      "type": "object",
      "required": [
        "elapsed_fraction", "expected_used_fraction", "used_fraction", "delta_points", "stage", "tone",
        "source", "resets_at", "projected_exhaustion_at", "lasts_until_reset"
      ],
      "properties": {
        "elapsed_fraction": { "type": "number", "minimum": 0 },
        "expected_used_fraction": { "type": "number", "minimum": 0 },
        "used_fraction": { "type": "number", "minimum": 0 },
        "delta_points": { "type": "number" },
        "stage": { "anyOf": [{ "enum": ["reserve", "on_pace", "ahead", "exhausted"] }, { "type": "string" }] },
        "tone": { "anyOf": [{ "enum": ["good", "neutral", "warn", "bad"] }, { "type": "string" }] },
        "source": { "anyOf": [{ "enum": ["average", "recent"] }, { "type": "string" }] },
        "resets_at": { "type": "string", "format": "date-time" },
        "projected_exhaustion_at": { "type": ["string", "null"], "format": "date-time" },
        "lasts_until_reset": { "type": "boolean" }
      }
    },
    "UsageAccess": {
      "type": "object",
      "required": [
        "level", "credential", "plan_requirement", "scope", "metered", "evidence", "verified_on",
        "summary", "credential_hint", "risk", "reason"
      ],
      "properties": {
        "level": { "anyOf": [{ "enum": ["official", "undocumented", "derived", "unavailable", "extension"] }, { "type": "string" }] },
        "credential": { "anyOf": [{ "enum": ["inference_key", "admin_key", "subscription_session", "cloud_identity", "local_cli", "user_session"] }, { "type": "string" }] },
        "plan_requirement": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Localized" }] },
        "scope": { "anyOf": [{ "enum": ["account", "organization", "whole_cloud", "product"] }, { "type": "string" }] },
        "metered": { "type": "boolean", "description": "Every query is billed." },
        "evidence": {
          "type": "object",
          "required": ["kind", "url"],
          "properties": {
            "kind": { "anyOf": [{ "enum": ["documentation", "reference"] }, { "type": "string" }] },
            "url": { "type": "string", "description": "Public page; never an authenticated URL." }
          }
        },
        "verified_on": { "type": "string", "format": "date" },
        "summary": { "$ref": "#/$defs/Localized" },
        "credential_hint": { "$ref": "#/$defs/Localized" },
        "risk": { "$ref": "#/$defs/Localized" },
        "reason": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Localized" }], "description": "Present exactly when level is unavailable." }
      }
    },
    "ProviderIncident": {
      "type": "object",
      "required": ["state", "label", "event", "page_url", "read_at", "stale", "expired"],
      "properties": {
        "state": { "anyOf": [{ "enum": ["operational", "degraded", "partial_outage", "major_outage", "maintenance", "unknown"] }, { "type": "string" }] },
        "label": { "$ref": "#/$defs/Localized" },
        "event": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["title", "started_at", "url"],
              "properties": {
                "title": { "type": "string", "description": "Provider title without markup, at most 120 characters." },
                "started_at": { "type": ["string", "null"], "format": "date-time" },
                "url": { "type": "string", "description": "Public https page on the status host." }
              }
            }
          ],
          "description": "The most severe active event in the provider's scope."
        },
        "page_url": { "type": "string", "description": "Public status page of the source." },
        "read_at": { "type": ["string", "null"], "format": "date-time", "description": "When the retained reading was obtained; null before the first one." },
        "stale": { "type": "boolean", "description": "The latest status query failed; state is the previous reading (unknown without one)." },
        "expired": { "type": "boolean", "description": "The retained reading is older than 30 minutes; state is unknown and event is null." }
      }
    },
    "Localized": {
      "type": "object",
      "required": ["id", "fallback"],
      "properties": {
        "id": { "type": "string", "description": "Stable catalog id." },
        "params": {
          "type": "object",
          "additionalProperties": { "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/Localized" }] },
          "description": "Absent when empty."
        },
        "fallback": { "type": "string", "description": "Portuguese text with the parameters already in place." }
      }
    },
    "LocalCost": {
      "type": "object",
      "description": "An estimate at API prices, not a charge. Only numbers, model names and texts: never a path, a file name or conversation content.",
      "required": ["currency", "notice", "span", "sources", "total", "pricing_error"],
      "properties": {
        "currency": { "const": "USD", "description": "Every amount; never summed with another currency or a provider's billing." },
        "notice": { "$ref": "#/$defs/Localized" },
        "span": { "$ref": "#/$defs/CostSpan" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/CostSource" }, "description": "Every local cost source, on or off." },
        "total": { "$ref": "#/$defs/CostEstimate", "description": "The span over every source that is on." },
        "pricing_error": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Localized" }], "description": "The user's pricing.json is invalid and ignored as a whole; embedded prices only." }
      }
    },
    "CostSpan": {
      "type": "object",
      "required": ["period", "days", "label", "first_day", "last_day"],
      "properties": {
        "period": { "anyOf": [{ "type": "null" }, { "enum": ["today", "last_7_days", "last_30_days", "current_month", "all"] }, { "type": "string" }], "description": "The saved period; null with a number of days." },
        "days": { "type": ["integer", "null"], "minimum": 1, "description": "The last N local days; null with a period." },
        "label": { "$ref": "#/$defs/Localized" },
        "first_day": { "type": ["string", "null"], "format": "date", "description": "First local day; null for everything the index holds." },
        "last_day": { "type": "string", "format": "date", "description": "Today, the computer's local day." }
      }
    },
    "CostSource": {
      "type": "object",
      "required": ["source", "label", "providers", "state", "note", "usage"],
      "properties": {
        "source": { "anyOf": [{ "enum": ["claude_code", "codex_cli"] }, { "type": "string" }], "description": "New sources add values." },
        "label": { "type": "string" },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/Provider" }, "description": "The accounts of these providers show this source." },
        "state": { "anyOf": [{ "enum": ["off", "ready", "partial", "no_logs", "no_access", "not_read"] }, { "type": "string" }] },
        "note": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/Localized" }], "description": "Why there are no numbers or what limits them; null when they are complete." },
        "usage": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/CostUsage" }], "description": "null while the source is off." }
      }
    },
    "CostUsage": {
      "type": "object",
      "required": ["today", "yesterday", "period", "days"],
      "properties": {
        "today": { "$ref": "#/$defs/CostEstimate" },
        "yesterday": { "$ref": "#/$defs/CostEstimate" },
        "period": { "$ref": "#/$defs/CostEstimate", "description": "The span; its models are the breakdown by model." },
        "days": { "type": "array", "items": { "$ref": "#/$defs/CostDay" }, "description": "Every local day of the span, oldest first, days without usage at zero; empty without usage." }
      }
    },
    "CostDay": {
      "type": "object",
      "required": ["day", "tokens", "requests", "cost", "unknown_tokens"],
      "properties": {
        "day": { "type": "string", "format": "date" },
        "tokens": { "$ref": "#/$defs/Tokens" },
        "requests": { "type": "integer", "minimum": 0 },
        "cost": { "type": ["number", "null"], "minimum": 0, "description": "USD of the priced part; null when nothing is priced, never 0 for unpriced usage." },
        "unknown_tokens": { "$ref": "#/$defs/Tokens" }
      }
    },
    "CostEstimate": {
      "type": "object",
      "required": ["currency", "total", "tokens", "requests", "unknown_tokens", "unknown_share", "models", "tables", "notice"],
      "properties": {
        "currency": { "const": "USD" },
        "total": { "type": ["number", "null"], "minimum": 0, "description": "USD of the usage with a known price; null when there is usage and none is priced." },
        "tokens": { "$ref": "#/$defs/Tokens" },
        "requests": { "type": "integer", "minimum": 0 },
        "unknown_tokens": { "$ref": "#/$defs/Tokens", "description": "Tokens of models without a known price." },
        "unknown_share": { "type": "number", "minimum": 0, "description": "unknown_tokens over tokens, 0 to 1." },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["model", "tokens", "requests", "cost", "price"],
            "properties": {
              "model": { "type": "string", "description": "As the logs name it." },
              "tokens": { "$ref": "#/$defs/Tokens" },
              "requests": { "type": "integer", "minimum": 0 },
              "cost": { "type": ["number", "null"], "minimum": 0, "description": "null: cost unknown, never 0." },
              "price": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["entry", "origin", "rates"],
                    "properties": {
                      "entry": { "type": "string", "description": "The table entry that matched." },
                      "origin": { "anyOf": [{ "enum": ["embedded", "user"] }, { "type": "string" }] },
                      "rates": { "$ref": "#/$defs/Rates" }
                    }
                  }
                ]
              }
            }
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["origin", "effective", "source"],
            "properties": {
              "origin": { "anyOf": [{ "enum": ["embedded", "user"] }, { "type": "string" }] },
              "effective": { "type": "string", "format": "date" },
              "source": { "type": ["string", "null"] }
            }
          },
          "description": "Date and source of each price table that priced a model."
        },
        "notice": { "$ref": "#/$defs/Localized" }
      }
    },
    "Tokens": {
      "type": "object",
      "required": ["input", "output", "cache_read", "cache_write"],
      "properties": {
        "input": { "type": "integer", "minimum": 0, "description": "Without the cached and cache-written parts." },
        "output": { "type": "integer", "minimum": 0 },
        "cache_read": { "type": "integer", "minimum": 0 },
        "cache_write": { "type": "integer", "minimum": 0 },
        "cache_write_1h": { "type": "integer", "minimum": 0, "description": "Claude 1-hour cache writes (PRD 0030 RF5); cache_write holds the 5-minute ones." }
      }
    },
    "Rates": {
      "type": "object",
      "description": "USD per million tokens.",
      "required": ["input", "output", "cache_read", "cache_write"],
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "cache_read": { "type": "number", "minimum": 0 },
        "cache_write": { "type": "number", "minimum": 0 },
        "cache_write_1h": { "type": "number", "minimum": 0, "description": "Absent when the table has no 1-hour price." }
      }
    }
  }
}
